            <div class="section-divider"></div>
        </div>
        <div class="panels-grid">
            <?php foreach ($dPanels as $p):
                $isActive = $activeStates[$p['key']] ?? false;
            ?>
            <div class="panel-item <?php echo $isActive ? 'active' : ''; ?>"
                 style="<?php echo $isActive ? 'border-left-color: ' . htmlspecialchars($p['color']) . ';' : ''; ?> position:relative;">
                <div class="panel-custom-badge" style="background:rgba(59,130,246,.12);border-color:rgba(59,130,246,.3);color:#93c5fd;">Division</div>
                <div class="panel-icon" style="background: <?php echo htmlspecialchars($p['color']); ?>22; color: <?php echo htmlspecialchars($p['color']); ?>;">
                    <i class="fa-solid fa-<?php echo htmlspecialchars($p['icon']); ?>"></i>
                </div>
                <div class="panel-content">
                    <div class="panel-name"><?php echo htmlspecialchars($p['name']); ?></div>
                    <div class="panel-key"><?php echo htmlspecialchars($p['key']); ?> · <?php echo htmlspecialchars($p['faction_name'] ?? ''); ?></div>
                </div>
                <?php if ($isActive): ?>
                    <span class="panel-status active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Actif</span>
                <?php else: ?>
                    <span class="panel-status inactive">Inactif</span>
                <?php endif; ?>
                <form method="POST" class="toggle-form">
                    <input type="hidden" name="panel_key" value="<?php echo htmlspecialchars($p['key']); ?>">
                    <input type="hidden" name="state" value="<?php echo $isActive ? '0' : '1'; ?>">
                    <label class="toggle" title="<?php echo $isActive ? 'Désactiver' : 'Activer'; ?>">
                        <input type="checkbox" onchange="this.closest('form').submit()" <?php echo $isActive ? 'checked' : ''; ?>>
                        <span class="toggle-slider"></span>
                    </label>
                </form>
            </div>
            <?php endforeach; ?>
        </div>
    </div>
    <?php endforeach; ?>
<?php endif; ?>

<!-- PANELS PERSONNALISÉS -->
<?php if (!empty($customPanels)): ?>
    <?php
    $customGrouped = [];
    foreach ($customPanels as $cp) {
        $customGrouped[$cp['cat']][] = $cp;
    }
    $totalCustom = count($customPanels);
