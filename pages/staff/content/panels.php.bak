        <span>Panels activés</span>
        <span><?php echo $activeCount; ?> / <?php echo $totalPanels; ?></span>
    </div>
    <div class="progress-bar">
        <div class="progress-fill" style="width: <?php echo round(($activeCount / $totalPanels) * 100); ?>%"></div>
    </div>
</div>

<!-- PANELS PAR CATÉGORIE -->
<?php foreach ($grouped as $catName => $panels): ?>
<div class="panels-section">
    <div class="section-header">
        <h2 class="section-title"><?php echo $catName; ?></h2>
        <div class="section-divider"></div>
        <span class="section-count">
            <?php echo count(array_filter(array_map(fn($p) => $activeStates[$p['key']] ?? false, $panels))); ?>/<?php echo count($panels); ?> actifs
        </span>
    </div>

    <div class="panels-grid">
        <?php foreach ($panels as $p):
            $isActive = $activeStates[$p['key']] ?? false;
        ?>
        <div class="panel-item <?php echo $isActive ? 'active' : ''; ?>"
             style="<?php echo $isActive ? 'border-left-color: ' . $p['color'] . ';' : ''; ?>">
            
            <div class="panel-icon" style="background: <?php echo $p['color']; ?>22; color: <?php echo $p['color']; ?>;">
                <i class="fa-solid fa-<?php echo $p['icon']; ?>"></i>
            </div>
            
            <div class="panel-content">
                <div class="panel-name"><?php echo htmlspecialchars($p['name']); ?></div>
                <div class="panel-key"><?php echo $p['key']; ?></div>
            </div>
            
            <?php if ($isActive): ?>
                <span class="panel-status active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Actif</span>
            <?php else: ?>
                <span class="panel-status inactive">Inactif</span>
            <?php endif; ?>
            
            <form method="POST" class="toggle-form">
                <input type="hidden" name="panel_key" value="<?php echo $p['key']; ?>">
                <input type="hidden" name="state" value="<?php echo $isActive ? '0' : '1'; ?>">
                <label class="toggle" title="<?php echo $isActive ? 'Désactiver' : 'Activer'; ?>">
                    <input type="checkbox" onchange="this.closest('form').submit()" <?php echo $isActive ? 'checked' : ''; ?>>
                    <span class="toggle-slider"></span>
                </label>
            </form>
        </div>
        <?php endforeach; ?>
    </div>
</div>
<?php endforeach; ?>

<!-- PANELS DIVISIONS (faction_divisions) -->
<?php if (!empty($divisionPanels)): ?>
    <?php
    $divGrouped = [];
    foreach ($divisionPanels as $dp) {
        $divGrouped[$dp['cat']][] = $dp;
    }
    $totalDiv = count($divisionPanels);
    $totalDivActive = count(array_filter($divisionPanels, fn($p) => $activeStates[$p['key']] ?? false));
    ?>
    <div class="custom-section-header" style="border-color:rgba(59,130,246,.25);background:linear-gradient(135deg,rgba(59,130,246,.06),rgba(37,99,235,.04));">
        <div class="custom-section-icon" style="background:rgba(59,130,246,.15);color:var(--blue);">
            <i class="fa-solid fa-sitemap"></i>
        </div>
        <div class="custom-section-content">
            <div class="custom-section-title">Divisions MDT</div>
            <div class="custom-section-desc"><?php echo $totalDivActive; ?>/<?php echo $totalDiv; ?> actifs — catalogue et divisions créées dans Extensions → Divisions</div>
        </div>
