    // Activités & Luxe
    ['key' => 'DIAMOND_CASINO', 'name' => 'Diamond Casino', 'icon' => 'dice',                'color' => '#e11d48', 'cat' => 'Activités & Luxe'],
    // Activités Illégales
    ['key' => 'DARKNET',      'name' => 'DarkNet',        'icon' => 'network-wired',       'color' => '#7c3aed', 'cat' => 'Activités Illégales'],
    // Cabinet d'Avocats
    ['key' => 'AVOCATS', 'name' => "Cabinet d'Avocats", 'icon' => 'scale-balanced', 'color' => '#d97706', 'cat' => "Services Publics"],
    // Gouvernement
    ['key' => 'GOUV',         'name' => 'Gouvernement',   'icon' => 'landmark',            'color' => '#1d4ed8', 'cat' => 'Gouvernement'],
];

// ── LOAD ACTIVE STATES ──
$activeStates = [];
try {
    $rows = $db->query("SELECT panel_key, is_active FROM admin_panels")->fetchAll();
    foreach ($rows as $r) $activeStates[$r['panel_key']] = (bool)$r['is_active'];
} catch (Exception $e) {}

// ── LOAD CUSTOM PANELS FROM DB ──
$customPanels = [];
try {
    $rows = $db->query("SELECT * FROM custom_panels ORDER BY category, created_at ASC")->fetchAll();
    foreach ($rows as $r) {
        $customPanels[] = [
            'key'    => $r['panel_key'],
            'name'   => $r['name'],
            'icon'   => $r['icon'],
            'color'  => $r['color'],
            'cat'    => $r['category'] ?? 'Commerces',
            'custom' => true,
            'faction'=> $r['faction_key'] ?? '',
        ];
    }
} catch (Exception $e) {}

// Ajouter les panels custom aux validKeys pour le toggle
$validCustomKeys = array_column($customPanels, 'key');

// ── Panels divisions (faction_divisions) ──
$divisionPanels = [];
$validDivisionKeys = [];
try {
    $rows = $db->query(
        "SELECT fd.panel_key, fd.name, fd.icon, fd.color, f.faction_key, f.name AS faction_name
         FROM faction_divisions fd
         INNER JOIN factions f ON f.id = fd.faction_id
         ORDER BY f.name ASC, fd.sort_order ASC, fd.name ASC"
    )->fetchAll(PDO::FETCH_ASSOC);
    foreach ($rows as $r) {
        $divisionPanels[] = [
            'key'    => $r['panel_key'],
            'name'   => $r['name'],
            'icon'   => $r['icon'] ?: 'layer-group',
            'color'  => $r['color'] ?: '#64748b',
            'cat'    => 'Divisions MDT',
            'faction'=> $r['faction_key'],
            'faction_name' => $r['faction_name'],
        ];
        $validDivisionKeys[] = $r['panel_key'];
    }
} catch (Exception $e) {}

// ── TOGGLE ──
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $key   = $_POST['panel_key'] ?? '';
    $state = (int)($_POST['state'] ?? 0);
    $validKeys = array_merge(array_column($allPanels, 'key'), $validCustomKeys, $validDivisionKeys);
    if (in_array($key, $validKeys, true)) {
        try {
            $db->prepare("INSERT INTO admin_panels (panel_key, is_active, updated_at) VALUES (?,?,NOW()) ON DUPLICATE KEY UPDATE is_active=?, updated_at=NOW()")->execute([$key, $state, $state]);
            $activeStates[$key] = (bool)$state;
            if (in_array($key, $validCustomKeys, true)) {
                try {
                    $db->prepare("UPDATE custom_panels SET is_active=? WHERE panel_key=?")->execute([$state, $key]);
                } catch (Exception $e2) {
                    /* colonne is_active absente sur anciennes bases */
                }
            }
            if (in_array($key, $validDivisionKeys, true)) {
                try {
                    $db->prepare("UPDATE faction_divisions SET is_active = ?, updated_at = NOW() WHERE panel_key = ? LIMIT 1")->execute([$state, $key]);
                } catch (Exception $e3) {
                    /* table absente */
                }
            }
            $newState = $state ? 'activé' : 'désactivé';
            $success  = "Panel $key $newState.";
        } catch (Exception $e) {
            $error = 'Enregistrement impossible : ' . $e->getMessage();
        }
    } else {
        $error = 'Clé de panel non reconnue ou non autorisée.';
    }
}

// Group by category
$grouped = [];
foreach ($allPanels as $p) {
    $grouped[$p['cat']][] = $p;
}

$totalPanels = count($allPanels) + count($customPanels) + count($divisionPanels);
$validKeysForStats = array_merge(array_column($allPanels, 'key'), $validCustomKeys, $validDivisionKeys);
$activeCount = 0;
foreach ($validKeysForStats as $vk) {
    if (!empty($activeStates[$vk])) {
        $activeCount++;
    }
}
include __DIR__ . '/../includes/header.php';
?>

